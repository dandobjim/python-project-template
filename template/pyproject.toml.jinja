{%- set min_minor = python_version.split('.')[1] | int -%}
[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python_version }}"
classifiers = [
    "Programming Language :: Python :: 3",
{%- for minor in range(min_minor, 15) %}
    "Programming Language :: Python :: 3.{{ minor }}",
{%- endfor %}
    "Operating System :: OS Independent",
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Homepage = "https://github.com/{{ github_username }}/{{ project_name }}"
Issues = "https://github.com/{{ github_username }}/{{ project_name }}/issues"

[build-system]
requires = ["uv_build>=0.9,<1.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_name }}"

[dependency-groups]
dev = [
{%- if type_checker == "mypy" %}
    "mypy>=2.4",
{%- endif %}
    "pre-commit>=4.0",
{%- if type_checker == "pyrefly" %}
    "pyrefly>=1.4",
{%- endif %}
    "pytest>=8.0",
    "pytest-cov>=6.0",
    "ruff>=0.17",
]

# ---------------------------------------------------------------------------
# Ruff
# ---------------------------------------------------------------------------
[tool.ruff]
line-length = 88
target-version = "py3{{ min_minor }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "N",   # pep8-naming
    "UP",  # pyupgrade
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "SIM", # flake8-simplify
    "PT",  # flake8-pytest-style
    "PTH", # flake8-use-pathlib
    "S",   # flake8-bandit (security)
    "RUF", # ruff-specific rules
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"] # assert is the pytest idiom

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true
{% if type_checker == "mypy" %}
# ---------------------------------------------------------------------------
# Mypy
# ---------------------------------------------------------------------------
[tool.mypy]
python_version = "{{ python_version }}"
strict = true
files = ["src", "tests"]
{%- else %}
# ---------------------------------------------------------------------------
# Pyrefly
# ---------------------------------------------------------------------------
[tool.pyrefly]
project-includes = ["src", "tests"]
search-path = ["src"]
python-version = "{{ python_version }}"
preset = "strict"
{%- endif %}

# ---------------------------------------------------------------------------
# Pytest
# ---------------------------------------------------------------------------
[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
addopts = [
    "-ra",
    "--strict-markers",
    "--strict-config",
    "--import-mode=importlib",
    "--cov",
    "--cov-report=term-missing",
]

# ---------------------------------------------------------------------------
# Coverage
# ---------------------------------------------------------------------------
[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
fail_under = {{ coverage_threshold }}
show_missing = true
skip_covered = false
exclude_also = [
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "@(abc\\.)?abstractmethod",
]
