│   ├── dependabot.yml          # weekly updates: actions, uv deps, pre-commit hooks
│   └── workflows/ci.yml        # CI: lint + tests on Python {{ python_version }}–3.14
├── src/{{ package_name }}/     # package source code
├── tests/                      # pytest test suite
├── .pre-commit-config.yaml     # git hooks (ruff, mypy, formatting, uv lock)
